        {
          "name": "getEstudiantesByGenero",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Devuelve un array\", function () {\n    const estudiantes = pm.response.json();\n\n    pm.expect(estudiantes).to.be.an(\"array\");\n});\n\npm.test(\"Todos son de género MASCULINO\", function () {\n    const estudiantes = pm.response.json();\n\n    estudiantes.forEach(estudiante => {\n        pm.expect(estudiante.Genero).to.eql(\"MASCULINO\");\n    });\n});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"genero\",\"Masculino\")"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/estudiantes?genero={{genero}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estudiantes"
              ],
              "query": [
                {
                  "key": "genero",
                  "value": "{{genero}}"
                }
              ]
            },
            "description": "Obtiene todos los estudiantes de acuerdo a su genero\n\nSi hay ocurrencias 200 ok\n\nSi no 400"
          },
          "response": []
        },
