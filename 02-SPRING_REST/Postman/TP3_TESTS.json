                "exec": [
                  "pm.test(\"Retorna un status 200 si devuelve un estudiante\", function () {\n  pm.response.to.have.status(200);\n});\n\npm.test(\"Comprobar si el estudiante 'Isidro Blackmuir' tiene un dni '71779527'\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.Dni).to.eql(71779527);\n});"
                ]
